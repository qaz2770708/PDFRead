<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PDFReader</AssemblyName>
    <ApplicationIcon>resources\PDFRead.ico</ApplicationIcon>
    <RootNamespace>PDFReader</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);work/**;outputs/**;tests/**;ui/node_modules/**;ui/dist/**</DefaultItemExcludes>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\PDFReaderApp.cs" />
    <Compile Include="src\ModernShell.cs" />
    <Compile Include="src\ContinuousPdfViewer.cs" />
    <Compile Include="src\DocumentData.cs" />
    <Compile Include="src\CentralDataStore.cs" />
    <Compile Include="src\SafePersistence.cs" />
    <Compile Include="src\DataTools.cs" />
    <Compile Include="src\AnnotationLayer.cs" />
    <Compile Include="src\AnnotationViewer.cs" />
    <Compile Include="src\AnnotationTools.cs" />
    <Compile Include="src\AnnotationIcons.cs" />
    <Compile Include="src\InlineTextEditor.cs" />
    <Compile Include="src\PdfTextRegions.cs" />
    <Compile Include="src\WindowsTextRecognition.cs" />
    <Compile Include="src\PdfNavigation.cs" />
    <Compile Include="src\PdfReaderNavigation.cs" />
    <Compile Include="src\BookmarkInteraction.cs" />
    <Compile Include="src\PdfAnnotationExporter.cs" />
    <Compile Include="src\PdfExportTools.cs" />
    <Compile Include="src\DocumentTabs.cs" />
    <Compile Include="src\PageThumbnails.cs" />
    <Compile Include="src\ReadingTools.cs" />
    <Compile Include="src\ReaderWorkspace.cs" />
    <Compile Include="src\NavigationPresentation.cs" />
    <Compile Include="src\WindowsPdfRenderer.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="ui\dist\**\*"><Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
