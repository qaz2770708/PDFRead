<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PDFReader</AssemblyName>
    <RootNamespace>PDFReader</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\PDFReaderApp.cs" />
    <Compile Include="src\ContinuousPdfViewer.cs" />
    <Compile Include="src\DocumentData.cs" />
    <Compile Include="src\WindowsPdfRenderer.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Runtime.WindowsRuntime">
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
